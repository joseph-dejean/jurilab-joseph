# Jurilab Environment Variables
# Copy this file to .env for local development.
# DO NOT COMMIT .env FILE

# ─────────────────────────────────────────────────────────────────────────────
# REMOVED — NO LONGER NEEDED
# ─────────────────────────────────────────────────────────────────────────────
# VITE_GEMINI_API_KEY — Gemini calls now go through the FastAPI backend (ADC)
# VITE_GOOGLE_CLIENT_SECRET — OAuth secrets must never be in the browser bundle

# ─────────────────────────────────────────────────────────────────────────────
# FIREBASE (public config — secured by Firebase Security Rules, not a secret)
# ─────────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE APIs — browser-side keys
# Restrict each key by HTTP referrer in GCP Console > APIs & Services > Credentials
# ─────────────────────────────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
VITE_GOOGLE_DEVELOPER_KEY=your_google_api_key_here
VITE_GOOGLE_APP_ID=your_project_number_here

# ─────────────────────────────────────────────────────────────────────────────
# THIRD-PARTY SERVICES
# ─────────────────────────────────────────────────────────────────────────────
VITE_DAILY_API_KEY=your_daily_api_key_here
VITE_STREAM_API_KEY=your_stream_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# PYTHON BACKEND (rag-juridique/.env) — set these for local dev
# On Cloud Run, GCP_PROJECT_ID and GCP_REGION are injected via --set-env-vars
# Gemini/Vertex AI auth uses ADC: run `gcloud auth application-default login`
# ─────────────────────────────────────────────────────────────────────────────
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_REGION=europe-west1
# GCP_DATASTORE_ID=legal-rag-datastore

# Légifrance / PISTE API (external — no ADC available)
# PISTE_CLIENT_ID=your_piste_client_id
# PISTE_CLIENT_SECRET=your_piste_client_secret
